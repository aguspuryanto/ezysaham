# Supabase — Dashboard → Project Settings → API
# Kosongkan bila belum ada: website tetap jalan, portofolio disimpan di localStorage.
NEXT_PUBLIC_SUPABASE_URL=
# Isi salah satu: publishable key (sb_publishable_...) atau anon key lama (eyJ...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (JANGAN beri prefix NEXT_PUBLIC_) ---
# Supabase → Project Settings → API Keys → secret key (sb_secret_...) atau service_role lama.
# Dipakai server pembayaran untuk mengaktifkan Pro (melewati RLS).
SUPABASE_SECRET_KEY=

# DOKU Back Office → Integration → API Keys (sandbox: dashboard-sandbox.doku.com)
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# sandbox (default) | production
DOKU_ENV=sandbox

# TokenKoding (narasi AI "Bedah Data") — server only. Kosongkan: narasi memakai versi berbasis aturan.
TOKENKODING_API_KEY=
# Opsional, default deepseek-v4.1-flash
TOKENKODING_MODEL=
