# Supabase — Dashboard → Project Settings → API
# Kosongkan bila belum ada: website tetap jalan, portofolio disimpan di localStorage.
NEXT_PUBLIC_SUPABASE_URL=
# Isi salah satu: publishable key (sb_publishable_...) atau anon key lama (eyJ...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (JANGAN beri prefix NEXT_PUBLIC_) ---
# Supabase → Project Settings → API Keys → secret key (sb_secret_...) atau service_role lama.
# Dipakai webhook pembayaran untuk mengaktifkan Pro (melewati RLS).
SUPABASE_SECRET_KEY=

# Xendit → Settings → API Keys → Secret key (izin Money-in: Write). Pakai key "development" untuk uji coba.
XENDIT_SECRET_KEY=
# Xendit → Settings → Webhooks → Verification token
XENDIT_CALLBACK_TOKEN=
