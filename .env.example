# Base URL API ezysaham (dipakai di server saja, tidak terekspos ke browser)
EZYSAHAM_API_BASE=https://ezysaham.vercel.app/api

# Supabase — Dashboard → Project Settings → API
# Kosongkan bila belum ada: website tetap jalan, portofolio disimpan di localStorage.
NEXT_PUBLIC_SUPABASE_URL=
# Isi salah satu: publishable key (sb_publishable_...) atau anon key lama (eyJ...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
